---
// Command prompt on the start page. The logic lives in @shubrt/term, this file only renders.
import { getCollection } from "astro:content";
import projectsData from "../data/projects.json";

const noteEntries = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 20);
const content = {
  projects: projectsData,
  notes: noteEntries.map((n) => ({ title: n.data.title, date: n.data.date.toISOString().slice(0, 10), url: `/notes/${n.id}` })),
};
---

<div class="mt-8">
  <div id="term-out" class="max-h-80 space-y-0.5 overflow-y-auto text-sm" aria-live="polite"></div>
  <form id="term-form" class="mt-2 flex items-center gap-2">
    <label for="term-in" class="select-none text-neutral-600 dark:text-neutral-400" aria-label="Command">$</label>
    <input id="term-in" type="text" autocomplete="off" spellcheck="false" class="w-full bg-transparent outline-none" placeholder="type help" />
  </form>
  <p id="term-hint" class="mt-1 h-4 text-xs text-neutral-500"></p>
</div>

<script is:inline define:vars={{ content }}>
  window.__content = content;
</script>

<script>
  import { History, Registry, clear, complete, help, initial, notes, projects, reduce, whoami, parse, type Action, type Content } from "@shubrt/term";

  const content = (window as unknown as { __content: Content }).__content;
  const history = new History();
  const registry = new Registry().register(whoami).register(clear).register(projects(content)).register(notes(content));
  registry.register(help(registry));

  const out = document.getElementById("term-out") as HTMLDivElement;
  const form = document.getElementById("term-form") as HTMLFormElement;
  const input = document.getElementById("term-in") as HTMLInputElement;
  const hint = document.getElementById("term-hint") as HTMLParagraphElement;

  let state = initial;

  const render = () => {
    out.replaceChildren(
      ...state.lines.map((l) => {
        const p = document.createElement("p");
        p.textContent = l.kind === "input" ? `$ ${l.text}` : l.text;
        p.className = l.kind === "input" ? "text-neutral-500" : l.kind === "error" ? "text-red-600 dark:text-red-400" : "";
        return p;
      }),
    );
    input.value = state.input;
    out.scrollTop = out.scrollHeight;
  };

  const dispatch = (action: Action) => {
    state = reduce(state, action, registry);
    render();
  };

  input.addEventListener("input", () => dispatch({ type: "type", value: input.value }));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const line = input.value;
    history.push(line);
    if (parse(line)?.name === "clear") dispatch({ type: "clear" });
    dispatch({ type: "submit" });
    input.focus();
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "Tab" && !input.value.includes(" ")) {
      const result = complete(input.value, registry.list().map((c) => c.name));
      input.value = result.value;
      hint.textContent = result.candidates.length > 1 ? result.candidates.join("  ") : "";
      e.preventDefault();
    } else if (e.key === "ArrowUp") {
      const prev = history.back();
      if (prev !== undefined) input.value = prev;
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      input.value = history.forward();
      e.preventDefault();
    }
  });
</script>
