---
// Command prompt on the start page. The logic lives in @shubrt/term, this file only renders.
import { getCollection } from "astro:content";
import projectsData from "../data/projects.json";

const noteEntries = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 20);
const version = `${new Date().toISOString().slice(0, 10)}`;
const content = {
  version,
  projects: projectsData,
  notes: noteEntries.map((n) => ({ title: n.data.title, date: n.data.date.toISOString().slice(0, 10), url: `/notes/${n.id}` })),
};
---

<div class="mt-8">
  <pre id="face" class="mb-3 hidden select-none text-xs leading-tight text-neutral-500 sm:block" aria-hidden="true">{` ( o.o )
  > ^ <`}</pre>
  <div id="term-out" class="max-h-80 space-y-0.5 overflow-y-auto text-sm" aria-live="polite"></div>
  <form id="term-form" class="mt-2 flex min-h-11 items-center gap-2 sm:min-h-0">
    <label for="term-in" class="select-none text-neutral-600 dark:text-neutral-400" aria-label="Command">$</label>
    <input id="term-in" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" class="w-full bg-transparent outline-none" placeholder="type help" />
  </form>
  <p id="term-hint" class="mt-1 h-4 text-xs text-neutral-500"></p>
</div>

<script is:inline define:vars={{ content }}>
  window.__content = content;
</script>

<script>
  import { History, Registry, clear, complete, createScheduler, help, tk, initial, notes, open, projects, reduce, theme, version, whoami, parse, type Action, type Content } from "@shubrt/term";

  const content = (window as unknown as { __content: Content }).__content;
  const history = new History();
  const registry = new Registry().register(whoami).register(clear).register(theme).register(open).register(version((content as unknown as { version: string }).version)).register(projects(content)).register(notes(content));
  registry.alias("ls", "projects").alias("cat", "whoami");
  registry.register(help(registry));

  const out = document.getElementById("term-out") as HTMLDivElement;
  const form = document.getElementById("term-form") as HTMLFormElement;
  const input = document.getElementById("term-in") as HTMLInputElement;
  const hint = document.getElementById("term-hint") as HTMLParagraphElement;

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const face = document.getElementById("face");
  if (face && !reduced) {
    const open = face.textContent ?? "";
    const closed = open.replace("o.o", "-.-");
    setInterval(() => {
      face.textContent = closed;
      setTimeout(() => {
        face.textContent = open;
      }, 120);
    }, 4000 + Math.random() * 3000);
  }
  let state = initial;

  const render = () => {
    out.replaceChildren(
      ...state.lines.map((l) => {
        const p = document.createElement("p");
        p.textContent = l.kind === "input" ? `$ ${l.text}` : l.text;
        p.className =
          l.kind === "input" ? "text-neutral-500" : l.kind === "error" ? "text-red-600 dark:text-red-400" : l.kind === "meta" ? "text-xs text-neutral-500" : "";
        if (l.kind === "meta") p.textContent = `${l.text} · ${tk(state.lines.map((x) => x.text).join(" "))} tok`;
        return p;
      }),
    );
    input.value = state.input;
    out.scrollTop = out.scrollHeight;
  };

  const scheduler = createScheduler(
    (line) => {
      state = { ...state, lines: [...state.lines, line] };
      render();
    },
    { delay: reduced ? 0 : 30 },
  );

  const dispatch = (action: Action) => {
    if (action.type === "submit") {
      const before = state.lines.length;
      const next = reduce(state, action, registry);
      const [echo, ...rest] = next.lines.slice(before);
      state = { ...next, lines: echo ? [...state.lines, echo] : state.lines };
      render();
      scheduler.push(rest);
      return;
    }
    state = reduce(state, action, registry);
    render();
  };

  dispatch({ type: "type", value: "whoami" });
  dispatch({ type: "submit" });
  if (matchMedia("(pointer: fine)").matches) input.focus({ preventScroll: true });

  input.addEventListener("input", () => dispatch({ type: "type", value: input.value }));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const line = input.value;
    history.push(line);
    if (parse(line)?.name === "clear") dispatch({ type: "clear" });
    dispatch({ type: "submit", now: () => performance.now() });
    const last = state.lines.filter((l) => l.kind !== "meta").at(-1)?.text;
    if (last?.startsWith("open: ") && !last.includes("unknown")) location.assign(last.slice(6));
    if (last === "theme: dark" || last === "theme: light") {
      document.documentElement.classList.toggle("dark", last.endsWith("dark"));
      localStorage.setItem("theme", last.endsWith("dark") ? "dark" : "light");
    }
    input.focus();
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "Tab" && !input.value.includes(" ")) {
      const result = complete(input.value, registry.list().map((c) => c.name));
      input.value = result.value;
      hint.textContent = result.candidates.length > 1 ? result.candidates.join("  ") : "";
      e.preventDefault();
    } else if (e.key === "ArrowUp") {
      const prev = history.back();
      if (prev !== undefined) input.value = prev;
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      input.value = history.forward();
      e.preventDefault();
    }
  });
</script>
