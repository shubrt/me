---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import { formatDate } from "../../lib/date";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={`${note.data.title} · Notes`}>
  <article>
    <h1 class="text-2xl font-semibold tracking-tight">{note.data.title}</h1>
    <p class="mt-2 text-sm text-neutral-500">
      <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, "long")}</time>
      <span> · {note.data.tags.join(", ")}</span>
    </p>
    <Prose class="mt-6">
      <Content />
    </Prose>
  </article>
</Base>
