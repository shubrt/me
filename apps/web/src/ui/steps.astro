---
import { renderHubDiagram, renderLanesDiagram, renderMailDiagram } from "./steps-diagrams.ts";
import { t, type Lang } from "../helper/i18n.ts";
import { listAgentTiles, listStructureTiles, listWorkflowTiles } from "./steps-tiles.ts";
import "./steps.css";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;

const steps = [
  {
    id: "structure",
    title: t(lang, "Struktur", "Structure"),
    tag: t(lang, "Wo liegt was?", "What lives where?"),
    text: t(
      lang,
      "Jede Information liegt an genau einer Stelle, und alle wissen, an welcher.",
      "Every piece of information lives in one place, and everyone knows where.",
    ),
    diagram: renderHubDiagram(lang),
    tiles: listStructureTiles(lang),
  },
  {
    id: "workflow",
    title: "Workflow",
    tag: t(lang, "Was passiert wann?", "What happens when?"),
    text: t(
      lang,
      "Wiederkehrende Arbeit läuft automatisch. Ihr Team kümmert sich nur noch um die Ausnahmen.",
      "Repetitive work runs automatically. Your team only handles the exceptions.",
    ),
    diagram: renderLanesDiagram(lang),
    tiles: listWorkflowTiles(lang),
  },
  {
    id: "agent",
    title: "Agent",
    tag: t(lang, "Was bleibt für die KI?", "What's left for AI?"),
    text: t(
      lang,
      "KI übernimmt nur, was keine feste Regel abdeckt. Das ist weniger, als die meisten denken.",
      "AI only handles what a fixed rule can't. That's less than most people think.",
    ),
    diagram: renderMailDiagram(lang),
    tiles: listAgentTiles(lang),
  },
];
---

<div class="steps">
  {
    steps.map((step, i) => {
      const isAgent = step.id === "agent";
      return (
        <>
          <div class:list={["guide", { "to-accent": isAgent }]} />
          <section id={step.id} class:list={{ accent: isAgent }}>
            <div class:list={["node", { accent: isAgent }]} data-first-node={i === 0 ? "" : undefined}>
              {i + 1}
            </div>
            <div class="bento wrap">
              <div class="title">
                <h2>{step.title}</h2>
                <h3>{step.tag}</h3>
                <p>{step.text}</p>
              </div>
              <div class="main" set:html={step.diagram} />
              {step.tiles.map((tile) => (
                <div class="tile">
                  <h4>{tile.title}</h4>
                  <p>{tile.text}</p>
                  <Fragment set:html={tile.picture} />
                </div>
              ))}
            </div>
          </section>
        </>
      );
    })
  }
  <div class="guide from-accent"></div>
</div>
