---
import { t, toLocalePath, type Lang } from "../helper/i18n.ts";
import "./base-layout.css";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. "/impressum/". Only the 404 page has
      none: it answers on every missing URL, so it stays out of the index. */
  path?: string;
};

const { lang, title, description, path } = Astro.props;

const url = path && toAbsoluteUrl(toLocalePath(lang, path));

const ADDRESS = {
  "@type": "PostalAddress",
  streetAddress: "Hauptstraße 15",
  postalCode: "55286",
  addressLocality: "Sulzheim",
  addressCountry: "DE",
};
const SAME_AS = ["https://github.com/shubrt"];
const personId = toAbsoluteUrl("/#person");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Janis Schubert",
      jobTitle: t(lang, "Software-Architekt", "Software architect"),
      url,
      sameAs: SAME_AS,
      address: ADDRESS,
    },
    {
      "@type": "ProfessionalService",
      name: "Janis Schubert",
      description,
      url,
      sameAs: SAME_AS,
      address: ADDRESS,
      founder: { "@id": personId },
    },
  ],
};

function toAbsoluteUrl(href: string) {
  return new URL(href, Astro.site).href;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      path ? (
        <>
          <link rel="canonical" href={url} />
          <link rel="alternate" hreflang="de" href={toAbsoluteUrl(toLocalePath("de", path))} />
          <link rel="alternate" hreflang="en" href={toAbsoluteUrl(toLocalePath("en", path))} />
          <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(toLocalePath("de", path))} />
          <meta property="og:url" content={url} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={toAbsoluteUrl(`/og-${lang}.png`)} />
    <meta property="og:locale" content={t(lang, "de_DE", "en_US")} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      path === "/" && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <!-- Marks that scripts run, so sections can fall back to their static end state. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
