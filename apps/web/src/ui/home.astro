---
import Base from "./base-layout.astro";
import { t, type Lang } from "../helper/i18n.ts";
import Chaos from "./chaos.astro";
import Contact from "./contact.astro";
import Footer from "./footer.astro";
import Hero from "./hero.astro";
import Nav from "./nav.astro";
import Reveal from "./reveal.astro";
import Steps from "./steps.astro";
import Towers from "./towers.astro";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
---

<Base
  lang={lang}
  path="/"
  title={t(
    lang,
    "Software-Architekt für KI und Automatisierung | Janis Schubert",
    "Software architect for AI and automation | Janis Schubert",
  )}
  description={t(
    lang,
    "Ich baue Software für den Mittelstand im Rhein-Main-Gebiet. Zuerst bringe ich die Daten in Ordnung, danach kommt die KI. Das Erstgespräch ist kostenlos.",
    "I build software for mid-sized businesses in the Rhine-Main area. I sort out the data first and bring in AI after that. The intro call is free.",
  )}
>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Chaos lang={lang} />
    <Steps lang={lang} />
    <Towers lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <Reveal />
</Base>
