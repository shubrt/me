---
import { Picture } from "astro:assets";
import portrait from "../asset/portrait.jpg";
import { t, type Lang } from "../helper/i18n.ts";
import "./contact.css";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;

const MAILTO = "mailto:kontakt@shubrt.me";
const email = t(lang, "E-Mail", "Email");
const message = t(lang, "Nachricht, optional", "Message, optional");
const topics = [
  { value: "structure", label: t(lang, "Struktur", "Structure") },
  { value: "workflow", label: "Workflow" },
  { value: "agent", label: "Agent" },
  { value: "unsure", label: t(lang, "Noch unklar", "Not sure yet") },
];
---

<section class="contact wrap" id="contact">
  <Picture
    src={portrait}
    formats={["avif", "webp"]}
    densities={[2]}
    quality={80}
    width={176}
    height={176}
    loading="lazy"
    alt={t(
      lang,
      "Porträt von Janis Schubert, lächelnd, mit Brille und Bart",
      "Portrait of Janis Schubert, smiling, with glasses and a beard",
    )}
  />
  <p class="who">
    {
      t(
        lang,
        "Janis Schubert, Software-Architekt im Rhein-Main-Gebiet",
        "Janis Schubert, software architect in the Rhine-Main area",
      )
    }
  </p>
  <h2>{t(lang, "Wo hakt es?", "Where does it hurt?")}</h2>
  <p class="lead">
    {
      t(
        lang,
        "Das Erstgespräch dauert 30 Minuten und kostet nichts. Wir klären, wo Sie am besten anfangen. Manchmal ist die ehrliche Antwort, dass Sie keine KI brauchen.",
        "The intro call takes 30 minutes and costs nothing. We work out where you should start. Sometimes the honest answer is that you don't need AI at all.",
      )
    }
  </p>

  <form method="post" action="/api/contact">
    <input type="hidden" name="lang" value={lang} />
    {/* The honeypot. Name and label mean nothing to autofill, so password managers leave it empty. */}
    <div class="trap" aria-hidden="true">
      <label>
        Leave this field empty
        <input type="text" name="trap" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
      </label>
    </div>

    <label class="field">
      <span class="sr-only">Name</span>
      <input type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Name" />
    </label>
    <label class="field">
      <span class="sr-only">{email}</span>
      <input type="email" name="email" required maxlength="254" autocomplete="email" placeholder={email} />
    </label>

    <fieldset>
      <legend>{t(lang, "Worum geht es am ehesten?", "What is it mainly about?")}</legend>
      {
        topics.map(({ value, label }) => (
          <label class="option">
            <input type="radio" name="topic" value={value} />
            <span>{label}</span>
          </label>
        ))
      }
    </fieldset>

    <label class="field wide">
      <span class="sr-only">{message}</span>
      <textarea name="message" maxlength="5000" placeholder={message}></textarea>
    </label>
    <button class="btn" type="submit">{t(lang, "Erstgespräch anfragen", "Request an intro call")}</button>
  </form>

  <!-- Shown by the script, or by :target after the no-JS redirect from /api/contact. -->
  <div class="status" role="status">
    <p id="sent" tabindex="-1">{
        t(
          lang,
          "Danke, Ihre Anfrage ist angekommen. Ich melde mich innerhalb einer Woche.",
          "Thanks, your request is in. I'll get back to you within a week.",
        )
      }</p>
    <p id="error">
      {t(lang, "Das hat leider nicht geklappt.", "Sorry, that didn't work.")}{" "}
      <a href={MAILTO}>{t(lang, "Schreiben Sie mir bitte direkt per E-Mail.", "Please email me directly.")}</a>
    </p>
  </div>

  <p class="note">
    {t(
      lang,
      "Ich nutze Ihre Angaben nur, um Ihnen zu antworten. Sie können mir auch",
      "I only use your details to reply to you. You can also",
    )}{" "}
    <a href={MAILTO}>{t(lang, "direkt eine E-Mail schreiben", "email me directly")}</a>.
  </p>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact form");
  const button = form?.querySelector("button");
  const sent = document.getElementById("sent");
  const error = document.getElementById("error");

  if (form && button && sent && error) {
    for (const chip of document.querySelectorAll<HTMLAnchorElement>("a[data-topic]")) {
      chip.addEventListener("click", (event) => selectTopic(event, chip, form));
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      error.classList.remove("on");

      const isAccepted = await sendInquiry(form);

      button.disabled = false;
      if (isAccepted) {
        sent.classList.add("on");
        sent.focus();
      } else {
        error.classList.add("on");
      }
    });
  }

  // Towers chips pick their topic. Focus lands on the radio, not on a text field,
  // so phones do not open the keyboard.
  function selectTopic(event: Event, chip: HTMLAnchorElement, form: HTMLFormElement) {
    // Once the form is swapped for the thanks there is nothing to fill in.
    if (!form.offsetParent) return;

    event.preventDefault();

    const radio = form.querySelector<HTMLInputElement>(`[value="${chip.dataset.topic}"]`);
    if (!radio) return;

    radio.checked = true;
    const isCalm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    form.scrollIntoView({ behavior: isCalm ? "instant" : "smooth", block: "center" });
    radio.focus({ preventScroll: true });
  }

  // A request that fails counts as not accepted.
  async function sendInquiry(form: HTMLFormElement) {
    const body = new FormData(form);
    body.set("elapsed", String(performance.now()));

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body,
      });

      return response.ok;
    } catch {
      return false;
    }
  }
</script>
