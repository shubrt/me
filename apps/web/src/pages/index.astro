---
import { getCollection } from "astro:content";
import { reposSchema } from "@shubrt/contracts";
import { ageVersion } from "@shubrt/session";
import Mascot from "../components/Mascot.astro";
import Terminal from "../islands/Terminal.tsx";
import { whoami } from "../data/whoami.ts";
import "../styles/terminal.css";

const entries = await getCollection("repos");
const repos = reposSchema.parse(
  entries.sort((a, b) => a.id.localeCompare(b.id)).map((entry) => entry.data),
);

const version = ageVersion();
// Rolled once per build so the server HTML and the hydrated island agree.
const seed = Math.random();

const title = "shubrt.me";
const description =
  "Janis Schubert, software architect in Mainz. A coding-agent terminal as a portfolio.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://shubrt.me/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shubrt.me/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="page">
      <main class="terminal">
        <header class="windowbar">
          <div class="traffic">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="window-title">shubrt.me</span>
          <span></span>
        </header>

        {/* Everything with state, plus what scrolls with it, lives in the island.
            The profile box travels as children so it is in the HTML without JS. */}
        <Terminal repos={repos} whoami={whoami} seed={seed} client:load>
          <div class="profile-panel">
            <div class="profile-main">
              <Mascot />
              <div class="identity">
                <div class="id-name">shubrt <span class="id-ver">/ {version}</span></div>
                <div class="id-role">janis schubert · software architect</div>
                <div class="id-path">mainz, de</div>
              </div>
            </div>
            <div class="command-nav">
              <button type="button" class="nav-btn" data-cmd="/whoami">/whoami</button>
              <button type="button" class="nav-btn" data-cmd="/projects">/projects</button>
              <button type="button" class="nav-btn" data-cmd="/help">/help</button>
            </div>
          </div>
        </Terminal>

        <div class="control-rail">
          <div class="mode-model">
            <span class="mode-active"><span class="mode-arrows">&gt;&gt;</span> auto mode on</span>
            <span class="model-info">sh-1 (250k context)</span>
          </div>
          <div class="socials">
            <button type="button" class="social-icon" data-social="github" aria-label="GitHub, link pending">
              <svg class="social-svg" viewBox="0 0 24 24" aria-hidden="true"><path
                  fill="currentColor"
                  d="M12 1.2A10.9 10.9 0 0 0 8.55 22.4c.55.1.75-.24.75-.53v-2.1c-3.05.66-3.7-1.3-3.7-1.3-.5-1.27-1.22-1.6-1.22-1.6-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.91.1-.71.38-1.2.7-1.47-2.44-.28-5-1.22-5-5.4 0-1.2.42-2.17 1.13-2.94-.11-.28-.49-1.4.11-2.9 0 0 .92-.3 3 1.12a10.4 10.4 0 0 1 5.46 0c2.08-1.42 3-1.12 3-1.12.6 1.5.22 2.62.11 2.9.7.77 1.13 1.74 1.13 2.94 0 4.2-2.57 5.11-5.01 5.39.39.34.74 1 .74 2.02v3c0 .3.2.64.76.53A10.9 10.9 0 0 0 12 1.2Z"
                ></path></svg>
            </button>
            <button type="button" class="social-icon" data-social="linkedin" aria-label="LinkedIn, link pending">
              <svg class="social-svg" viewBox="0 0 24 24" aria-hidden="true"><path
                  fill="currentColor"
                  d="M5.2 8.4H1.6V22h3.6V8.4ZM3.4 2A2.1 2.1 0 1 0 3.4 6.2 2.1 2.1 0 0 0 3.4 2Zm10.3 6.4h-3.5V22h3.6v-6.7c0-1.76.33-3.47 2.52-3.47 2.16 0 2.18 2.02 2.18 3.58V22h3.6v-7.43c0-3.65-.79-6.46-5.05-6.46-2.05 0-3.42 1.12-3.98 2.18h-.05V8.4Z"
                ></path></svg>
            </button>
            <button type="button" class="social-icon" data-social="email" aria-label="Email, address pending">
              <svg class="social-svg" viewBox="0 0 24 24" aria-hidden="true"><path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  d="M2.5 5.5h19v13h-19zM3.5 6.5 12 13l8.5-6.5"
                ></path></svg>
            </button>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
