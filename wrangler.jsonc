{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shubrt-me",
  "compatibility_date": "2026-08-01",
  // Binds shubrt.me on deploy; the zone must live in the same account.
  "routes": [{ "pattern": "shubrt.me", "custom_domain": true }],
  // The contact form's worker. Only /api/* starts it: static assets ride the
  // fast path without a cold start.
  "main": "./apps/web/src/_/worker.ts",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // `wrangler dev` simulates this binding: it logs the mail and sends nothing.
  "send_email": [{ "name": "EMAIL" }],
}
