---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
import { fetchRepo } from "../lib/github";

const enriched = await Promise.all(
  projects.map(async (p) => {
    const match = p.url?.match(/github\.com\/([^/]+\/[^/]+)/);
    const info = match ? await fetchRepo(match[1]) : null;
    return { ...p, info };
  }),
);
const sorted = enriched.sort((a, b) => (b.info?.pushedAt ?? b.updated).localeCompare(a.info?.pushedAt ?? a.updated));
---

<Base title="Projects · Janis Schubert">
  <h1 class="text-2xl font-semibold tracking-tight">Projects</h1>
  <p class="mt-4 leading-relaxed text-neutral-600 dark:text-neutral-400">Things I have built or am building. The list is short on purpose.</p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {sorted.map((p) => <ProjectCard {...p} />)}
  </ul>
</Base>
