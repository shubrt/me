---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog · Janis Schubert">
  <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
  <ul class="mt-6 space-y-4">
    {
      posts.map((post) => (
        <li>
          <a class="font-medium underline" href={`/blog/${post.slug}`}>{post.data.title}</a>
          <time class="ml-2 text-sm text-neutral-500" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}
          </time>
        </li>
      ))
    }
  </ul>
</Base>
