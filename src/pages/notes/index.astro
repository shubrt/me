---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Notes · Janis Schubert">
  <h1 class="text-2xl font-semibold tracking-tight">Notes</h1>
  <p class="mt-4 leading-relaxed text-neutral-600 dark:text-neutral-400">Short notes on things I learned. Smaller than blog posts, which is the point.</p>
  <ul class="mt-8 divide-y divide-neutral-200 dark:divide-neutral-800">
    {
      notes.map((n) => (
        <li class="flex items-baseline justify-between gap-4 py-2">
          <div>
            <a class="font-medium hover:underline" href={`/notes/${n.id}`}>{n.data.title}</a>
            <span class="ml-2 text-xs text-neutral-500">{n.data.tags.join(", ")}</span>
          </div>
          <time class="shrink-0 text-sm text-neutral-500" datetime={n.data.date.toISOString()}>
            {n.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}
          </time>
        </li>
      ))
    }
  </ul>
</Base>
