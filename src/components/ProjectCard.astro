---
import type { RepoInfo } from "../lib/github";

interface Props {
  name: string;
  description: string;
  url?: string;
  language: string;
  info?: RepoInfo | null;
}

const { name, description, url, language, info } = Astro.props;

const colors: Record<string, string> = {
  Astro: "bg-orange-100 text-orange-900 dark:bg-orange-950 dark:text-orange-200",
  TypeScript: "bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-200",
  Go: "bg-cyan-100 text-cyan-900 dark:bg-cyan-950 dark:text-cyan-200",
};
const shown = info?.language ?? language;
const badge = colors[shown] ?? "bg-neutral-100 dark:bg-neutral-800";
const pushed = info ? new Date(info.pushedAt).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" }) : null;
---

<li class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
  {url ? <a href={url} class="font-medium hover:underline">{name}</a> : <span class="font-medium">{name}</span>}
  <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{description}</p>
  <div class="mt-3 flex items-center gap-3 text-xs">
    <span class:list={["inline-block rounded px-2 py-0.5", badge]}>{shown}</span>
    {info && info.stars > 0 && <span class="text-neutral-500">★ {info.stars}</span>}
    {pushed && <span class="text-neutral-500">pushed {pushed}</span>}
  </div>
</li>
