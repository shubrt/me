---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/reading", label: "Reading" },
  { href: "/now", label: "Now" },
  { href: "/notes", label: "Notes" },
  { href: "/uses", label: "Uses" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isGerman = current.startsWith("/de");
const switchHref = isGerman ? current.replace(/^\/de/, "") || "/" : `/de${current === "/" ? "" : current}`;
---

<header class="mx-auto flex max-w-2xl items-center justify-between px-5 pt-5 sm:pt-8">
  <a href="/" class="font-semibold tracking-tight">shubrt</a>
  <nav class="flex items-center gap-3 text-sm sm:gap-4 text-neutral-600 dark:text-neutral-300">
    {
      links.map((l) => (
        <a href={l.href} class:list={["hover:text-neutral-900 dark:hover:text-neutral-100", { "text-neutral-900 dark:text-neutral-100": current === l.href }]}>
          {l.label}
        </a>
      ))
    }
    <a href={switchHref} hreflang={isGerman ? "en" : "de"} class="hover:text-neutral-900 dark:hover:text-neutral-100">{isGerman ? "EN" : "DE"}</a>
    <ThemeToggle />
  </nav>
</header>
